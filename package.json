{
  "name": "webwire",
  "version": "0.9.0",
  "description": "WebWire - AI-powered web application framework",
  "type": "module",
  "scripts": {
    "dev:full": "webpack --mode development --watch --config webpack.multi.config.cjs --config-name full",
    "dev:lite": "webpack --mode development --watch --config webpack.multi.config.cjs --config-name lite",
    "dev:all": "webpack --mode development --watch --config webpack.multi.config.cjs",
    "build:full": "webpack --mode production --config webpack.multi.config.cjs --config-name full",
    "build:lite": "webpack --mode production --config webpack.multi.config.cjs --config-name lite",
    "build:all": "webpack --mode production --config webpack.multi.config.cjs",
    "clean": "rimraf dist-full dist-lite",
    "package:full": "cd dist-full && zip -r ../webwire-full.zip .",
    "package:lite": "cd dist-lite && zip -r ../webwire-lite.zip .",
    "dev:vite": "vite --host",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "rimraf": "^5.0.10",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^3.3.4",
    "vite": "^5.0.0",
    "vitest": "^3.2.4",
    "webpack": "^5.98.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@sentry/browser": "^9.43.0",
    "js-tiktoken": "^1.0.20"
  }
}
